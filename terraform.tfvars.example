# Copy this file to terraform.tfvars (or <env>.tfvars) and fill in real
# values before running `terraform apply`. Do NOT commit the filled-in file.
# terraform.tfvars is already excluded via .gitignore.
#
# Provider credentials (HARNESS_ACCOUNT_ID, HARNESS_PLATFORM_API_KEY,
# HARNESS_ENDPOINT) are supplied via environment variables, not variables
# here. See versions.tf and README.md.

org_id     = "your_org_id"
project_id = "your_project_id"

# Production chaos infra IDs, composite "{environmentId}/{infraId}" format.
# k8s_prod_infra_ids targets OSE by default (works for any KubernetesV2
# platform). Required, at least one ID each.
k8s_prod_infra_ids   = ["your-environment-id/your-ose-cluster-infra-id"]
linux_prod_infra_ids = ["your-environment-id/your-linux-prod-infra-id"]

# Namespaces that must never be targeted without extra approval.
protected_namespaces = ["prod", "payments", "checkout"]

# Every chaos service account used in this project.
service_accounts = ["litmus"]

# Harness user group(s) every rule in this module applies to.
user_groups_ids = ["_project_all_users"]

# Time windows: adjust to your organization's calendar.
rule_time_zone                = "Asia/Dubai"
always_on_start_time          = 1711238400000 # epoch millis
always_on_duration            = "24h"
business_hours_start_time     = 1711267200000 # epoch millis
business_hours_duration       = "1h"
change_freeze_start_time      = 1711238400000 # epoch millis
change_freeze_duration        = "24h"
change_freeze_recurrence_type = "Daily"
change_freeze_until           = -1
